DOMAIN=loyalty.example.com
DB_PASSWORD=ganti-dengan-password-acak
# Buat: openssl rand -base64 48
JWT_SECRET=ganti-dengan-string-acak-min-32-karakter
# Hanya dipakai saat tabel admins masih kosong; hapus dari file setelah login pertama.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ganti-min-12-karakter
# WhatsApp via Fonnte (token dari dashboard Fonnte > device). Kosong = OTP nonaktif, verifikasi manual lewat admin.
FONNTE_TOKEN=
# Alternatif gateway generik (hanya dipakai jika FONNTE_TOKEN kosong):
WA_WEBHOOK_URL=
WA_WEBHOOK_TOKEN=
